{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remediation-evidence-v1.schema.json",
  "title": "Remediation evidence index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave",
    "evidence_stage",
    "tested_git_head",
    "implementation_parent_git_head",
    "platform",
    "environment_record",
    "dependency_versions",
    "dependency_inputs",
    "tested_input_policy",
    "tested_input_inventory_sha256",
    "commands",
    "source_config_bindings",
    "reviewed_plan_binding",
    "verification_contract_binding",
    "files"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "index_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "size_bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "kind": {
          "enum": [
            "command",
            "junit",
            "environment",
            "dependency",
            "plan_binding",
            "privacy_transform",
            "reproduced_source",
            "review",
            "adjudicator",
            "domain"
          ]
        },
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependency_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "remediation-evidence-index-v1"},
    "wave": {
      "enum": [
        "wave-0",
        "wave-a",
        "wave-b",
        "wave-c",
        "wave-d0",
        "wave-d1",
        "wave-e"
      ]
    },
    "evidence_stage": {"enum": ["candidate", "closure"]},
    "tested_git_head": {"$ref": "#/$defs/git_sha"},
    "implementation_parent_git_head": {"$ref": "#/$defs/git_sha"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "release",
        "architecture",
        "python_implementation",
        "python_version"
      ],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "python_implementation": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1}
      }
    },
    "environment_record": {"$ref": "#/$defs/file_record"},
    "dependency_versions": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency_version"}
    },
    "dependency_inputs": {
      "type": "array",
      "minItems": 1,
      "description": "Dependency path uniqueness and case-fold aliases are enforced by the production evidence-index validator.",
      "items": {"$ref": "#/$defs/file_record"}
    },
    "tested_input_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "selection_rules",
        "exclusion_rules",
        "inputs"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "selection_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:prefix|exact|top_level_suffix):.+$"
          }
        },
        "exclusion_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:prefix|exact|top_level_suffix):.+$"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "description": "Input path uniqueness and case-fold aliases are enforced by the production evidence-index validator.",
          "items": {"$ref": "#/$defs/file_record"}
        }
      }
    },
    "tested_input_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "commands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/file_record"}
    },
    "source_config_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_record"}
    },
    "reviewed_plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "commit"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/git_sha"}
      }
    },
    "verification_contract_binding": {"$ref": "#/$defs/file_record"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/index_file"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"wave": {"const": "wave-0"}},
        "required": ["wave"]
      },
      "then": {
        "properties": {
          "dependency_inputs": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "properties": {"path": {"const": "pyproject.toml"}},
                "required": ["path"]
              },
              {
                "properties": {
                  "path": {
                    "const": "environments/cuda-rtx5090-cu128.lock.txt"
                  }
                },
                "required": ["path"]
              },
              {
                "properties": {
                  "path": {
                    "const": "docs/verification/remediation/verification-contract-v1.json"
                  }
                },
                "required": ["path"]
              }
            ],
            "items": false
          },
          "tested_input_policy": {
            "properties": {
              "schema_version": {
                "const": "wave-0-source-config-theory-tools-tests-v1"
              },
              "selection_rules": {
                "const": [
                  "prefix:src/",
                  "prefix:tests/",
                  "prefix:Theory/",
                  "prefix:tools/",
                  "top_level_suffix:.py",
                  "exact:pyproject.toml",
                  "exact:.gitignore",
                  "exact:.gitattributes",
                  "exact:environments/cuda-rtx5090-cu128.lock.txt",
                  "exact:docs/audits/2026-08-11-post-fixed-ray-deep-audit.md",
                  "exact:docs/superpowers/specs/2026-08-11-scientific-integrity-remediation-program-design.md",
                  "exact:docs/superpowers/plans/2026-08-11-scientific-integrity-remediation-wave-0.md",
                  "exact:docs/verification/remediation/verification-contract-v1.json",
                  "prefix:docs/verification/remediation/"
                ]
              },
              "exclusion_rules": {
                "const": [
                  "prefix:docs/verification/evidence/",
                  "prefix:verification-evidence/",
                  "prefix:.verification/",
                  "prefix:.pytest_cache/",
                  "prefix:.pytest-"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
